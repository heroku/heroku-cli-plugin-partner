{
  "name": "heroku-cli-plugin-partner",
  "description": "Heroku CLI plugin for Heroku partner integrations",
  "version": "0.0.0",
  "author": "Heroku",
  "bugs": "https://github.com/heroku/heroku-cli-plugin-partner/issues",
  "dependencies": {
    "@heroku-cli/command": "^12.3.3",
    "@heroku-cli/schema": "^2.0.1",
    "@heroku/heroku-cli-util": "^10.8.0",
    "@oclif/core": "^4.10.0",
    "@oclif/plugin-help": "^6.2.48",
    "@types/form-data": "^2.5.2",
    "axios": "^1.15.2",
    "form-data": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2",
    "@heroku-cli/test-utils": "^0.3.0",
    "@oclif/test": "^4.1.18",
    "@types/chai": "^4.3.14",
    "@types/mocha": "^10",
    "@types/nock": "^11.1.0",
    "@types/node": "25.8.0",
    "@types/sinon": "^21.0.0",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "eslint": "^10",
    "eslint-config-oclif": "^6.0.164",
    "eslint-import-resolver-typescript": "^4.4.4",
    "mocha": "^11",
    "nock": "^14.0.15",
    "oclif": "^4",
    "shx": "^0.4.0",
    "sinon": "^22.0.0",
    "strip-ansi": "^7.2.0",
    "ts-node": "^10",
    "tsheredoc": "^1.0.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "files": [
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/heroku/heroku-cli-plugin-partner",
  "keywords": [
    "heroku-plugin",
    "oclif"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "oclif": {
    "commands": "./dist/commands",
    "bin": "heroku",
    "dirname": "heroku-cli-plugin-partner",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "topics": {
      "partner": {
        "description": "manage Heroku partner integrations",
        "subtopics": {
          "connect": {
            "description": "manage Heroku Connect integrations"
          }
        }
      }
    }
  },
  "repository": "heroku/heroku-cli-plugin-partner",
  "scripts": {
    "prepare": "npm run build",
    "build:dist": "shx rm -rf dist && tsc -b --force && oclif manifest",
    "build": "shx rm -rf dist && tsc && npm run manifest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "manifest": "oclif manifest",
    "pretest": "npm run build:dist",
    "test": "c8 mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
