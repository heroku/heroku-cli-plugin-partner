{
  "name": "heroku-cli-plugin-partner",
  "description": "Heroku CLI plugin for Heroku partner integrations",
  "version": "0.0.0",
  "author": "Heroku",
  "bugs": "https://github.com/heroku/heroku-cli-plugin-partner/issues",
  "dependencies": {
    "@heroku-cli/color": "^2",
    "@heroku-cli/command": "^12.1.3",
    "@heroku-cli/schema": "^2.0.1",
    "@heroku/heroku-cli-util": "^10.6.0",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/nock": "^10.0.3",
    "@types/node": "22.14.1",
    "@types/sinon": "^21.0.0",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^10",
    "nock": "^14.0.11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "sinon": "^21.0.2",
    "stdout-stderr": "^0.1.13",
    "strip-ansi": "^7.2.0",
    "ts-node": "^10",
    "tsheredoc": "^1.0.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/heroku/heroku-cli-plugin-partner",
  "keywords": [
    "heroku-plugin",
    "oclif"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "oclif": {
    "commands": "./dist/commands",
    "bin": "heroku",
    "dirname": "heroku-cli-plugin-partner",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "topics": {
      "partner": {
        "description": "manage Heroku partner integrations"
      }
    }
  },
  "repository": "heroku/heroku-cli-plugin-partner",
  "scripts": {
    "prepare": "yarn build",
    "build:dist": "shx rm -rf dist && tsc -b && oclif manifest && shx cp oclif.manifest.json ./dist/oclif.manifest.json",
    "build": "shx rm -rf dist && tsc -b && oclif manifest && oclif readme && shx cp oclif.manifest.json ./dist/oclif.manifest.json && shx cp README.md ./dist/README.md",
    "lint": "eslint .",
    "pretest": "yarn build:dist",
    "posttest": "yarn lint",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
